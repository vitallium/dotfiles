{{- $existingConfigPath := joinPath .chezmoi.homeDir ".codex" "config.toml" -}}
{{- $extractorPath := joinPath .chezmoi.sourceDir ".chezmoitemplates" "codex" "extract-project-trust.js" -}}

#:schema https://developers.openai.com/codex/config-schema.json

model = "gpt-5.6-terra"
model_reasoning_effort = "high"
tool_output_token_limit = 25000
# Leave room for native compaction near the 272–273k context window.
# Formula: 273000 - (tool_output_token_limit + 15000)
# With tool_output_token_limit=25000 ⇒ 273000 - (25000 + 15000) = 233000
model_auto_compact_token_limit = 233000
personality = "pragmatic"

[features]
ghost_commit = false
unified_exec = true
apply_patch_freeform = true
skills = true
shell_snapshot = true
hooks = true

{{- $obsidianVault := .obsidian.vault_path }}
{{- $mcpServers := get .mcp_servers .chezmoi.os }}
{{- range $server := $mcpServers }}
[mcp_servers.{{ $server.name }}]
{{- if eq $server.type "remote" }}
url = "{{ $server.url }}"
{{- else if eq $server.type "local" }}
command = {{ index $server.command 0 | quote }}
{{- if eq $server.name "obsidian" }}
args = [{{ $obsidianVault | quote }}]
{{- else }}
args = {{ toJson (slice $server.command 1) }}
{{- end }}
{{- with $server.env }}

[mcp_servers.{{ $server.name }}.env]
{{- range $key, $value := . }}
{{ $key }} = "{{ $value }}"
{{- end }}
{{- end }}
{{- end }}

[mcp_servers.{{ $server.name }}.tools.list_servers]
approval_mode = "approve"
{{- end }}

[marketplaces.compound-engineering-plugin]
source_type = "git"
source = "https://github.com/EveryInc/compound-engineering-plugin.git"

[marketplaces.ponytail]
source_type = "git"
source = "https://github.com/DietrichGebert/ponytail.git"

[marketplaces.illo-skill]
source_type = "git"
source = "https://github.com/tmchow/illo-skill.git"

[plugins."ponytail@ponytail"]
enabled = true

[plugins."illo@illo-skill"]
enabled = true

[plugins."compound-engineering@compound-engineering-plugin"]
enabled = true

[hooks.state]

[hooks.state."ponytail@ponytail:hooks/claude-codex-hooks.json:session_start:0:0"]
trusted_hash = "sha256:5f81d38f47448a1581c08ec877e044d9e04dd6f814dce3f2671f7a8edadd719b"

[hooks.state."ponytail@ponytail:hooks/claude-codex-hooks.json:user_prompt_submit:0:0"]
trusted_hash = "sha256:6a6f42bc3b58d6262db38bfd74d7f340fcca2b09cdb134aad365063f0bfefca4"

[hooks.state."ponytail@ponytail:hooks/claude-codex-hooks.json:subagent_start:0:0"]
trusted_hash = "sha256:1423b56c1322f96c8f74c51c1e7ae9a047b904c1fa43ee9165d462fd7a6e70ef"

[hooks.state."{{ .chezmoi.homeDir }}/.codex/hooks.json:stop:0:0"]
trusted_hash = "sha256:6078c145089ef0335dc5f6630e245fa647f942006518fac4c05190aa0d32fa8e"

{{- $preservedProjects := "" -}}
{{- if stat $existingConfigPath -}}
{{- $preservedProjects = output "node" $extractorPath $existingConfigPath | trim -}}
{{- end -}}

{{- if $preservedProjects }}

# Preserved local project trust entries from the existing destination config
{{ $preservedProjects }}
{{- end }}
