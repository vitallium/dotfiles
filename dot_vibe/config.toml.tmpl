active_model = "mistral-medium-3.5"
vim_keybindings = false
theme = "auto"
disable_welcome_banner_animation = false
autocopy_to_clipboard = true
file_watcher_for_autocomplete = false
displayed_workdir = ""
context_warnings = false
voice_mode_enabled = false
narrator_enabled = false
active_transcribe_model = "voxtral-realtime"
active_tts_model = "voxtral-tts"
bypass_tool_permissions = false
raise_on_compaction_failure = false
enable_telemetry = true
system_prompt_id = "cli"
compaction_prompt_id = "compact"
include_commit_signature = false
include_model_info = true
include_project_context = true
include_prompt_detail = true
enable_update_checks = true
enable_notifications = true
enable_system_trust_store = false
api_timeout = 720.0
api_retry_max_elapsed_time = 300.0
auto_compact_threshold = 200000
tool_paths = []

# MCP Servers - populated from .chezmoidata/mcp_servers.yml
{{- $obsidianVault := .obsidian.vault_path }}
{{- $mcpServers := get .mcp_servers .chezmoi.os }}
{{- range $server := $mcpServers }}
[[mcp_servers]]
name = "{{ $server.name }}"
{{- if eq $server.type "remote" }}
transport = "http"
url = "{{ $server.url }}"
{{- else if eq $server.type "local" }}
transport = "stdio"
{{- if eq $server.name "obsidian" }}
command = ["mcpvault", "{{ $obsidianVault }}"]
{{- else }}
command = {{ toJson $server.command }}
{{- end }}
{{- if $server.env }}
  env = {{ toJson $server.env }}
{{- end }}
{{- end }}
{{- if $server.description }}
description = "{{ $server.description }}"
{{- end }}

{{- end }}
