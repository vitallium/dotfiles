{
  "lastChangelogVersion": "1.7.0",
  "theme": "light/dark",
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.2-sol",
  "defaultThinkingLevel": "medium",
  "defaultTools": [
    "+codemode",
    "+tool_search",
    "+grep",
    "+find",
    "+ls"
  ],
  "packages": [
    "npm:pi-mcp-adapter@7.0.1",
    "npm:pi-web-access@0.48.0",
    "npm:@plannotator/pi-extension@0.29.6",
    "npm:@dietrichgebert/ponytail@5.3.3",
    "npm:@juicesharp/rpiv-ask-user-question@2.16.0",
    "npm:@ff-labs/pi-fff@0.11.0",
    "npm:pi-intercom@0.19.0",
    "npm:pi-context-view@0.9.0",
    "npm:pi-subagents@0.90.0",
    "npm:pi-posthorse@0.10.39",
    "npm:@nicknisi/pi-session-name@0.4.1",
    "npm:@nicknisi/pi-composer@1.0.1",
    "git:github.com/johnlindquist/pi-emphasis@f884b736c489944ee778ab951c7f78580f137b02",
    "git:github.com/EveryInc/compound-engineering-plugin@ee3695a24ae1ccb205e4334b79799cb25c060247",
    "git:github.com/obra/superpowers#22f0b463e7a5e579904dd6211a520321035526f7"
  ],
  "deviceId": "a856887f-a875-4738-acd5-cfc16ec9e0ac",
  "extensions": [
    "-builtin:mcp"
  ],
  "enabledModels": [
    "openai/gpt-6-astra:low",
    "openai/gpt-6.2-sol:medium",
    "openai/gpt-6.1-terra:medium",
    "openai/gpt-6-luna:high",
    "mistral/mistral-medium-latest",
    "mistral/mistral-large-latest",
    "mistral/zai-glm-5-3",
    "mistral/deepseek-v4-1-flash-1017",
    "xai/grok-4.7"
  ],
  "retry": {
    "enabled": true,
    "maxRetries": 5,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetryDelayMs": 30000
    }
  },
  "enableInstallTelemetry": false,
  "compaction": {
    "enabled": true,
    "reserveTokens": 64000,
    "keepRecentTokens": 40000
  },
  "subagents": {
    "agentOverrides": {
      "delegate": {
        "model": "openai/gpt-6.1-terra",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "openai/gpt-6-astra"
      },
      "oracle": {
        "model": "openai/gpt-6-astra",
        "thinking": "high"
      },
      "advisor": {
        "model": "openai/gpt-6.2-sol",
        "thinking": "high"
      },
      "scout": {
        "model": "openai/gpt-6-luna",
        "thinking": "low"
      },
      "worker": {
        "model": "openai/gpt-6.1-terra",
        "thinking": "medium"
      },
      "researcher": {
        "model": "openai/gpt-6-luna",
        "thinking": "low"
      }
    }
  }
}
