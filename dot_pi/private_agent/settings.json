{
  "lastChangelogVersion": "1.3.0",
  "theme": "system",
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "medium",
  "packages": [
    "npm:pi-subagents",
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:pi-lens",
    "npm:@plannotator/pi-extension",
    "npm:@dietrichgebert/ponytail",
    "npm:@ff-labs/pi-fff",
    "npm:pi-intercom",
    "npm:pi-context-view",
    "npm:pi-rules"
  ],
  "deviceId": "a856887f-a875-4738-acd5-cfc16ec9e0ac",
  "extensions": [
    "-builtin:mcp"
  ],
  "enabledModels": [
    "openai/gpt-6.1-sol:medium",
    "openai/gpt-6-astra:low",
    "openai/gpt-6-luna:xhigh",
    "mistral/mistral-medium-latest",
    "mistral/mistral-large-latest",
    "xai/grok-4.7"
  ],
  "subagents": {
    "agentOverrides": {
      "delegate": {
        "model": "openai/gpt-6.1-sol",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "openai/gpt-6-astra",
        "thinking": "xhigh"
      },
      "oracle": {
        "model": "openai/gpt-6-astra",
        "thinking": "xhigh"
      },
      "advisor": {
        "model": "openai/gpt-6-astra",
        "thinking": "xhigh"
      },
      "scout": {
        "model": "openai/gpt-6.1-sol",
        "thinking": "low"
      },
      "worker": {
        "model": "openai/gpt-6.1-sol",
        "thinking": "medium"
      },
      "researcher": {
        "model": "openai/gpt-6.1-sol",
        "thinking": "low"
      }
    }
  },
  "retry": {
    "enabled": true,
    "maxRetries": 5,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetryDelayMs": 30000
    }
  },
  "enableInstallTelemetry": false
}