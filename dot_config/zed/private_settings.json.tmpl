{
  "use_system_window_tabs": true,
  "cli_default_open_behavior": "existing_window",
  "agent_servers": {
    "antigravity-acp": {
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "mistral-vibe": {
      "type": "registry"
    },
    "grok-build": {
      "type": "registry"
    }
  },
  "agent": {
    "default_profile": "container-use",
    "profiles": {
      "container-use": {
        "name": "Container Use",
        "tools": {
          "fetch": true,
          "thinking": true,
          "copy_path": false,
          "find_path": false,
          "delete_path": false,
          "create_directory": false,
          "list_directory": false,
          "diagnostics": false,
          "read_file": false,
          "open": false,
          "move_path": false,
          "grep": false,
          "edit_file": false,
          "terminal": false
        },
        "enable_all_context_servers": false,
        "context_servers": {
          "container-use": {
            "tools": {
              "environment_add_service": true,
              "environment_checkpoint": true,
              "environment_config": true,
              "environment_create": true,
              "environment_file_delete": true,
              "environment_file_edit": true,
              "environment_file_list": true,
              "environment_file_read": true,
              "environment_file_write": true,
              "environment_open": true,
              "environment_run_cmd": true,
              "environment_update_metadata": true
            }
          }
        }
      }
    },
    "default_model": {
      "enable_thinking": true,
      "effort": "high",
      "provider": "zed.dev",
      "model": "gpt-5.6-luna"
    },
    "tool_permissions": {
      "tools": {
        "mcp:container-use:environment_file_edit": {
          "default": "allow"
        },
        "mcp:container-use:environment_config": {
          "default": "allow"
        },
        "mcp:container-use:environment_file_read": {
          "default": "allow"
        },
        "mcp:container-use:environment_run_cmd": {
          "default": "allow"
        },
        "mcp:container-use:environment_file_list": {
          "default": "allow"
        },
        "mcp:container-use:environment_create": {
          "default": "allow"
        }
      }
    },
  },
  "edit_predictions": {
    "mode": "subtle",
    "provider": "zed"
  },
  "theme": {
    "light": "Modus Operandi",
    "dark": "Modus Vivendi"
  },
  "buffer_font_family": "{{ .zed.buffer_font.name }}",
  "buffer_font_size": {{ .zed.buffer_font.size }},
  "markdown_preview_font_family": "{{ .zed.markdown_font.name }}",
  "terminal": {
    "font_family": "{{ .zed.terminal_font.name }}",
    "env": {
      "GIT_EDITOR": "zed --wait"
    }
  },
  "context_servers": {
{{- $obsidianVault := .obsidian.vault_path }}
{{- $mcpServers := get .mcp_servers .chezmoi.os }}
{{- range $index, $server := $mcpServers }}
    "{{ $server.name }}": {
{{- if eq $server.type "remote" }}
      "url": "{{ $server.url }}"
{{- else if eq $server.type "local" }}
      "command": {{ index $server.command 0 | toJson }}{{ if or (gt (len $server.command) 1) (eq $server.name "obsidian") $server.env }},{{ end }}
{{- if eq $server.name "obsidian" }}
      "args": [{{ $obsidianVault | toJson }}]{{ if $server.env }},{{ end }}
{{- else if gt (len $server.command) 1 }}
      "args": {{ toJson (slice $server.command 1) }}{{ if $server.env }},{{ end }}
{{- end }}
{{- if $server.env }}
      "env": {{ toJson $server.env }}
{{- end }}
{{- end }}
    }{{ if lt $index (sub (len $mcpServers) 1) }},{{ end }}
{{- end }}
  },
  "languages": {
    "Ruby": {
      "semantic_tokens": "combined",
      "language_servers": ["ruby-lsp"]
    }
  }
}
